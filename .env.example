# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5433/gateway
APP_URL=http://localhost:3000
# At least 32 random characters: openssl rand -base64 48
SECRET_KEY=

# Set to true only behind a proxy that appends the client's address to X-Forwarded-For
TRUST_PROXY=false
# How many proxies append to X-Forwarded-For in front of the app. Railway is 2. Check it on your host: docs/runbooks/railway.md
TRUSTED_PROXY_HOPS=1

# Email: console (local only), resend, or file
EMAIL_PROVIDER=console
EMAIL_FROM=Gateway <no-reply@example.com>
RESEND_API_KEY=

# Build time. Set true only for a test-mode deployment, so the browser trusts the simulator's key.
# Production leaves this unset, and the browser trusts only NEAR's signing key. Live mode refuses a test build.
# NEXT_PUBLIC_TEST_BUILD=true

# Payments. PAYMENTS_MODE=sim is test mode. PAYMENTS_MODE=live with a failed gate stops payments.
PAYMENTS_MODE=sim
# Live also needs all of these. The phrase must match exactly:
# LIVE_PAYMENTS_ACK=I understand this moves real customer funds
LIVE_PAYMENTS_ACK=
ONECLICK_API_KEY=
ONECLICK_BASE_URL=https://1click.chaindefuser.com
NEAR_RPC_URL=https://rpc.mainnet.near.org
# Your own fee, in basis points, on top of the route's. Needs a recipient on NEAR Intents.
APP_FEE_BPS=0
APP_FEE_RECIPIENT=
# Only after a live canary proves Intents recipients escape NEAR's origin-to-origin minimums.
MINIMUMS_EXEMPT_INTENTS_RECIPIENT=false

# Limits, in USD
MIN_PAYMENT_USD=1
MAX_PAYMENT_USD=1000000

# Geo-blocking needs a CDN that reports the country, such as cf-ipcountry.
GEO_COUNTRY_HEADER=
BLOCKED_COUNTRIES=CU,IR,KP,SY
