{
  "name": "gateway",
  "version": "0.1.0",
  "description": "Prototype crypto payment gateway: payment links, checkout widget and dashboard. Frontend-only, no real payments.",
  "keywords": [
    "crypto-payments",
    "payment-gateway",
    "payment-links",
    "checkout-widget",
    "near-intents",
    "web3",
    "nextjs",
    "react",
    "typescript",
    "tailwindcss",
    "tailwind-v4",
    "boardui",
    "react-aria",
    "app-router",
    "mock-ui",
    "prototype"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/copy-standalone.mjs && npm run build:worker",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "build:worker": "esbuild worker/index.ts server/db/migrate.ts scripts/ops.ts --bundle --platform=node --format=esm --external:pg-native --conditions=react-server --outdir=dist --out-extension:.js=.mjs --tsconfig=tsconfig.json \"--banner:js=import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "worker": "tsx --conditions=react-server --tsconfig tsconfig.json worker/index.ts",
    "dev:db": "tsx scripts/dev-db.ts",
    "ops": "tsx scripts/ops.ts",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.mts",
    "test:mutation": "node scripts/mutate-guards.mjs"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.4",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@remixicon/react": "^4.9.0",
    "@scure/base": "^1.2.6",
    "@web3icons/react": "4.1.24",
    "drizzle-orm": "^0.45.4",
    "motion": "^12.43.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "18.6.0-beta.19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  }
}
